# Copy these values into Streamlit Community Cloud > App settings > Secrets.
# Never commit a real API key to GitHub.
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"

# Primary models
GEMINI_MODEL = "gemini-3.7-flash"
GEMINI_REPORT_MODEL = "gemini-3.7-flash"

# v0.7 reliability: temporary 429/5xx/high-demand failures are retried, then
# the fallback model is used automatically.
GEMINI_FALLBACK_MODEL = "gemini-3.6-flash"
GEMINI_MAX_RETRIES = 2

# Keep false for the public deployment. Set true only for owner diagnostics.
SHOW_DEVELOPER_TOOLS = false
