  "rules": [
    {
      "Rule": "E-R1",
      "원칙": "Effect는 바람직한 기술적 결과로 표현한다."
    },
    {
      "Rule": "E-R2",
      "원칙": "Problem을 단순 부정형으로 뒤집어서 Effect를 생성하지 않는다."
    },
    {
      "Rule": "E-R3",
      "원칙": "Design Attribute와 구체 Effect를 분리한다."
    },
    {
      "Rule": "E-R4",
      "원칙": "특허가 주장하지 않는 비용·중량 효과를 임의로 추가하지 않는다."
    },
    {
      "Rule": "E-R5",
      "원칙": "Specific Effect가 확인되면 Generic Effect보다 우선한다."
    },
    {
      "Rule": "E-R6",
      "원칙": "한 특허에 복수 Effect를 허용한다."
    },
    {
      "Rule": "E-R7",
      "원칙": "Primary Effect는 보고서 표시용으로만 1개 지정할 수 있다."
    },
    {
      "Rule": "E-R8",
      "원칙": "지식 저장은 Multi-label을 기본으로 한다."
    },
    {
      "Rule": "E-R9",
      "원칙": "Original Effect Expression과 Evidence를 보존한다."
    },
    {
      "Rule": "E-R10",
      "원칙": "효과가 불명확하면 unclear / not_identified를 허용한다."
    }
  ],
  "evidence_levels": [
    {
      "Level": "EE1",
      "명칭": "Explicit Effect",
      "기준": "발명의 효과/작용효과에서 직접 명시",
      "보고서 사용": "사용"
    },
    {
      "Level": "EE2",
      "명칭": "Explicit Specification Effect",
      "기준": "Summary/Description에서 결과를 직접 명시",
      "보고서 사용": "사용"
    },
    {
      "Level": "EE3",
      "명칭": "Directly Supported Effect",
      "기준": "구조와 설명으로 직접 뒷받침되나 효과문장 자체는 없음",
      "보고서 사용": "사용 - 인간 검증 권장"
