  "assignment_schema": [
    {
      "Field": "claim_instance_id",
      "예": "C03",
      "설명": "Function이 부여되는 실제 Claim Element instance"
    },
    {
      "Field": "function_id",
      "예": "F-FLX-09",
      "설명": "Master Function ID"
    },
    {
      "Field": "target_instance_id",
      "예": "C01",
      "설명": "기능의 대상이 명시되는 경우 target 저장"
    },
    {
      "Field": "evidence_level",
      "예": "E1 / E2 / E3 / E4",
      "설명": "근거 수준"
    },
    {
      "Field": "evidence_text",
      "예": "\"...\"",
      "설명": "Claim/Description 원문 근거"
    },
    {
      "Field": "source_section",
      "예": "Claim 1 / Description",
      "설명": "근거 출처"
    },
    {
      "Field": "is_patent_fact",
      "예": "true/false",
      "설명": "E1-E3 중 정책에 따라 Patent Fact 여부"
    }
  ],
  "rules": [
    {
      "Rule": "F-R1",
      "원칙": "Canonical Function은 snake_case 동사형으로 표현한다."
    },
    {
      "Rule": "F-R2",
      "원칙": "First/Second, Front/Rear, Cable/Belt target 등은 가능하면 Function명 대신 instance/attribute/target으로 저장한다."
    },
    {
      "Rule": "F-R3",
      "원칙": "하나의 Claim Element는 복수 Function을 가질 수 있고, 하나의 Function을 여러 Claim Element가 수행할 수 있다."
    },
    {
      "Rule": "F-R4",
      "원칙": "Problem과 Effect를 Function으로 만들지 않는다. 예: Cable Slack=Problem, NVH Reduction=Effect."
    },
    {
      "Rule": "F-R5",
      "원칙": "Relation과 동일한 의미의 Function을 만들지 않는다. 예: engages_with는 Relation에 두고 Function은 latch_door로 둔다."
    },
    {
      "Rule": "F-R6",
      "원칙": "E4 Domain Inference는 실제 특허 Fact로 출력하지 않는다."
    },
    {
      "Rule": "F-R7",
      "원칙": "MVP Strict 분석은 Direct Function + E1/E2를 우선한다."
    },
    {
      "Rule": "F-R8",
      "원칙": "새 Function은 기존 Function + target/attribute로 표현할 수 없는 경우에만 추가한다."
    }
  ],
