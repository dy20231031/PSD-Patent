  "validation_rules": [
    {
      "Rule": "V01",
      "Validation": "모든 Claim Element Instance는 정확히 1개 Master 또는 unmapped_candidate를 가진다."
    },
    {
      "Rule": "V02",
      "Validation": "모든 Relation Subject/Object는 실제 Instance로 존재해야 한다."
    },
    {
      "Rule": "V03",
      "Validation": "Relation의 Domain/Range 제약을 만족해야 한다."
    },
    {
      "Rule": "V04",
      "Validation": "State Value는 지정된 State Dimension의 허용값이어야 한다."
    },
    {
      "Rule": "V05",
      "Validation": "Constraint는 실제 존재하는 Entity/Relation/State를 참조해야 한다."
    },
    {
      "Rule": "V06",
      "Validation": "E1/E2 Claim Evidence는 claim_id를 필수로 가진다."
    },
    {
      "Rule": "V07",
      "Validation": "E4/PE4/EE4는 Patent Fact 출력에 사용할 수 없다."
    },
    {
      "Rule": "V08",
      "Validation": "First/Second 등 Instance 표현으로 별도 Master를 생성하지 않는다."
    },
    {
      "Rule": "V09",
      "Validation": "Front/Rear 등 위치차이는 기본적으로 Attribute로 우선 처리한다."
    },
    {
      "Rule": "V10",
      "Validation": "State를 Claim Element Attribute에 중복 저장하지 않는다."
    },
    {
      "Rule": "V11",
      "Validation": "Entity mobility와 Relation motion에 동일 사실을 중복 저장하지 않는다."
    },
    {
      "Rule": "V12",
      "Validation": "Dependent Claim dependency cycle을 허용하지 않는다."
    },
    {
      "Rule": "V13",
      "Validation": "Technology는 Multi-label을 허용한다."
    },
    {
      "Rule": "V14",
      "Validation": "display_primary는 최대 1개만 허용한다."
    },
    {
      "Rule": "V15",
      "Validation": "미등록 Claim Element를 기존 Master에 강제 정규화하지 않는다."
    }
  ],
